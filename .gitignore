# 敏感配置（环境变量实际值）
.env

# 用户个人代码仓库路径映射
config/code-repos.yaml

# 用户生成的项目导航文件（首次 setup 时生成）
projects/*
!projects/_convention.md

# 用户从代码扫描生成的端侧知识库（保留 _convention.md）
knowledge/b-side/*
!knowledge/b-side/_convention.md
knowledge/c-side/*
!knowledge/c-side/_convention.md

# 用户积累的策略（排查经验随使用增长，保留 _convention.md）
memory/strategies.yaml
memory/archived-strategies.yaml
memory/audit-log.yaml
memory/audit-archive/
memory/session-state.yaml

# Python
__pycache__/
*.pyc
.venv/

# 排查临时文件
/tmp/
runtime/

# OS
.DS_Store
