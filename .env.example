# Compass Skill 环境变量模板
# 安装后复制为 .env：cp .env.example .env
# .env 已被 .gitignore 排除，请不要提交真实凭证
#
# 最小可用只需要 CODE_ROOT；各数据源凭证按需填写。
#
# 能力对应关系：
# - 只读代码 / B 端页面到后端链路：CODE_ROOT
# - 查日志 / traceId：SLS[index].*
# - 查 prod Doris：PLATFORM[index].*
# - 查 test/uat MySQL：MYSQL[index].*
# - 查 test/uat Redis：REDIS[index].*
# - 查 ES：ES[index].*

# ===== 最小必填：代码仓库根目录 =====
CODE_ROOT=

# ===== Harness（可选）=====
# COMPASS_PYTHON=/absolute/path/to/python
# Agent 自动模式下由 `scripts/compass-agent-auto.sh` 或 `compass action env` 注入；人工直查 adapter 时不要设置。
# COMPASS_ADAPTER_MODE=agent_auto
# COMPASS_AGENT_AUTO=0
# COMPASS_RUNTIME_STATE_FILE=
# COMPASS_RUNTIME_ACTION_ID=
# HARN_CONTEXT_WARN_TOKENS=40000
# HARN_CONTEXT_COMPRESS_TOKENS=60000
# HARN_CONTEXT_EMERGENCY_TOKENS=80000

# ===== 门禁规则（可选）=====
# prod 门禁不可关闭；非生产环境可按需放宽。
# COMPASS_NON_PROD_RELAX_GATES=0
# COMPASS_SQL_GATE_MEDIUM_ROWS=100000
# COMPASS_SQL_GATE_HIGH_ROWS=1000000
# COMPASS_SLS_GENERIC_KEYWORDS=异常,失败,余额不足,支付,订单
# COMPASS_SLS_KEYWORD_SOURCES=code,sql,schema,table_field,code_sql,none

# ===== 动态数据源配置 =====
# 统一格式：ADAPTER[index].FIELD=value
# 通用字段：NAME / ENV / DESC / LINK
# 可选默认 profile：REDIS_DEFAULT_PROFILE / MYSQL_DEFAULT_PROFILE / SLS_DEFAULT_ENV 等

# ===== SLS =====
SLS_DEFAULT_ENV=prod
SLS[0].NAME=PROD
SLS[0].ENV=prod
SLS[0].DESC=生产环境 SLS 日志 Project
SLS[0].ENDPOINT=cn-hangzhou.log.aliyuncs.com
SLS[0].PROJECT=
SLS[0].ACCESS_KEY_ID=
SLS[0].ACCESS_KEY_SECRET=
# 默认使用 all；如需切换其他 logstore，排查流程必须先让用户确认。
SLS[0].LOGSTORE=all
SLS[0].LINK=

# ===== Platform (Doris) =====
PLATFORM_DEFAULT_PROFILE=PROD
PLATFORM[0].NAME=PROD
PLATFORM[0].ENV=prod
PLATFORM[0].DESC=生产环境 Doris 查询平台
PLATFORM[0].BASE_URL=http://10.20.0.2:8081
PLATFORM[0].USERNAME=
PLATFORM[0].PASSWORD=
PLATFORM[0].HEADER_USER=X-User-Name
PLATFORM[0].HEADER_PASS=X-Password
PLATFORM[0].TIMEOUT=30
PLATFORM[0].EXPORT_TIMEOUT=120
PLATFORM[0].LINK=

# ===== MySQL / PolarDB =====
# MYSQL_DEFAULT_PROFILE=FINANCE_TEST
# MYSQL[0].NAME=FINANCE_TEST
# MYSQL[0].ENV=test
# MYSQL[0].DESC=财务测试环境 MySQL/PolarDB
# MYSQL[0].HOST=
# MYSQL[0].PORT=3306
# MYSQL[0].USER=
# MYSQL[0].PASSWORD=
# MYSQL[0].DATABASE=yunkc_finance
# MYSQL[0].LINK=

# ===== Redis =====
# REDIS_DEFAULT_PROFILE=FINANCE_TEST
# REDIS[0].NAME=FINANCE_TEST
# REDIS[0].ENV=test
# REDIS[0].DESC=财务测试环境 Redis，钱包/清分相关缓存
# REDIS[0].MODE=standalone
# REDIS[0].HOST=
# REDIS[0].PORT=6379
# REDIS[0].PASSWORD=
# REDIS[0].DB=30
# REDIS[0].LINK=

# ===== Elasticsearch =====
# ES_DEFAULT_PROFILE=FINANCE_TEST
# ES[0].NAME=FINANCE_TEST
# ES[0].ENV=test
# ES[0].DESC=财务测试环境 ES
# ES[0].URL=
# ES[0].USERNAME=elastic
# ES[0].PASSWORD=
# ES[0].LINK=
