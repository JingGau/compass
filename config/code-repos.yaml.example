# 代码仓库路径配置模板
# 复制为 code-repos.yaml 后修改：cp config/code-repos.yaml.example config/code-repos.yaml
#
# 路径解析规则（优先级从高到低）：
#   1. projects.<name> 如果是绝对路径（以 / 开头）→ 直接使用
#   2. projects.<name> 如果是相对路径 → 拼接 code_root
#   3. 没有在 projects 映射中的项目 → 在 code_root 下递归扫描同名子目录
#
# code_root 支持 ${ENV_VAR:-default} 语法，从 .env 的 CODE_ROOT 读取
# 首次运行 /setup 时会自动生成此文件

code_root: ${CODE_ROOT}

# projects 映射：key = 项目目录名，value = 相对路径（相对于 code_root）
# 目录名与代码目录名一致的项目可以省略，AI 会自动发现
# 只需要配置在子目录下或名称不同的项目
projects:
  # 示例（按你的实际目录结构填写）：
  # finance_server: FINANCE/finance_server
  # order-server: TRADE/order-server
  # omp-shop: Front/omp-shop
